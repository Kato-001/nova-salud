# Apache (XAMPP / Laragon): todo pasa por el controlador frontal
Options -Indexes
RewriteEngine On

# Archivos públicos (CSS, JS, imágenes, ícono): solo Frontend/public
RewriteRule ^assets/(.*)$ Frontend/public/assets/$1 [END]
RewriteRule ^favicon\.svg$ Frontend/public/favicon.svg [END]

# Nunca exponer código, pantallas sueltas, configuración ni scripts SQL
RewriteRule ^(Bakend|Docs|Frontend|\.env|\.git) - [F,L]

# El resto lo atiende PHP
RewriteRule ^ api/index.php [END,QSA]
