@startuml 26_rel_p2
!include estilo.iuml
skinparam PackageBackgroundColor #FFF6B3/#FDE98A
title Relación del paquete P2 Gestión médica con sus casos de uso
left to right direction
package "P2 GESTIÓN MÉDICA" as PK {
  skinparam rectangle<<oculto>> {
    BackgroundColor transparent
    BorderColor transparent
    StereotypeFontSize 0
    shadowing false
  }
  rectangle "<size:40>                                        </size>\n\n\n" <<oculto>> as X
}
usecase "CU4\nGestionar especialidades" as CU4
PK ..> CU4 : <<include>>
usecase "CU5\nGestionar médicos" as CU5
PK ..> CU5 : <<include>>
usecase "CU6\nGestionar horarios" as CU6
PK ..> CU6 : <<include>>
@enduml
