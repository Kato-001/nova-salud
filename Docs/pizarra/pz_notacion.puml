@startuml pz_notacion
title Notación del diagrama de componentes
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
component "Componente" as c1
component "Componente" as c2 <<componente>>
rectangle "<<componente>>\nComponente" as c3
package "Nombre.Ext" as p1 {
}
c1 -[hidden]right- c2
c2 -[hidden]right- c3
c3 -[hidden]right- p1
@enduml
