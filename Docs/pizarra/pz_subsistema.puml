@startuml pz_subsistema
title Implementación de la arquitectura del subsistema P1: Gestionar Consultas Esp. Médicas (ejemplo)
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam ranksep 50
package "Interfaz" {
  component "FRegFicha" as f1 <<form>>
  component "FConsultaMExt" as f2 <<form>>
  component "RConsultaExt" as f3 <<Reporte>>
  component "FHistorialExt" as f4 <<form>>
}
package "Clases" {
  component "GFichaExt" as c1 <<class>>
  component "GConsultaExt" as c2 <<class>>
  component "RConsultaExt" as c3 <<class>>
  component " " as c4 <<class>>
}
package "Tablas" {
  component "TFichaExt" as t1 <<table>>
  component "TConsultaExt" as t2 <<table>>
  component "TPaciente" as t3 <<table>>
  component "THistorial" as t4 <<table>>
}
f1 ..> c1
f2 ..> c2
f3 ..> c3
f4 ..> c4
c1 ..> t1
c2 ..> t2
c3 ..> t1
c3 ..> t2
c3 ..> t3
c4 ..> t4
@enduml
